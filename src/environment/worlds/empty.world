<?xml version="1.0" ?>

<sdf version="1.6">
  <world name="default">

    <!-- Plugin for simulating physics -->
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>

    <!-- Plugin for handling user commands -->
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>

    <!-- Plugin for broadcasting scene updates -->
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>

    <!-- Plugin for handling sensors like the LIDAR -->
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Plugin for IMU -->
    <plugin filename="gz-sim-imu-system"
      name="gz::sim::systems::Imu">
    </plugin>

    <!-- To add realistic gravity, do: 0.0 0.0 -9.8, otherwise do 0.0 0.0 0.0 -->
    <gravity>0.0 0.0 -9.8</gravity>    

     <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.5 0.5 0.5 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Include a model of the Ground Plane from an external URI -->
    <include>
      <uri>
        https://fuel.gazebosim.org/1.0/OpenRobotics/models/Ground Plane
      </uri>
    </include>

    <!-- ===== OBJECT GRID (0.5m spacing) ===== -->

    <!-- Row 0: apple / banana / pizza / bad_apple -->
        <!-- ===== OBJECT GRID WITH DISHES (0.5m spacing) ===== -->

    <!-- Row 0: apple_good -->
    <model name="dish_apple_good">
      <include>
        <uri>model://WhiteDish</uri>
        <static>true</static>
        <pose>0.0 0.0 0.20 0 0 0</pose>
      </include>
    </model>

    <model name="apple_good">
      <include>
        <uri>model://AppleGood</uri>
        <static>true</static>
        <pose>0.0 0.0 0.25 0 0 0</pose>
      </include>
    </model>


    <!-- banana_good -->
    <model name="dish_banana_good">
      <include>
        <uri>model://WhiteDish</uri>
        <static>true</static>
        <pose>0.5 0.0 0.20 0 0 0</pose>
      </include>
    </model>

    <model name="banana_good">
      <include>
        <uri>model://BananaGood</uri>
        <static>true</static>
        <pose>0.5 0.0 0.25 0 0 0</pose>
      </include>
    </model>


    <!-- pizza_good -->
    <model name="dish_pizza_good">
      <include>
        <uri>model://WhiteDish</uri>
        <static>true</static>
        <pose>1.0 0.0 0.20 0 0 0</pose>
      </include>
    </model>

    <model name="pizza_good">
      <include>
        <uri>model://PizzaGood</uri>
        <static>true</static>
        <pose>1.0 0.0 0.25 0 0 0</pose>
      </include>
    </model>


    <!-- apple_bad -->
    <model name="dish_apple_bad">
      <include>
        <uri>model://WhiteDish</uri>
        <static>true</static>
        <pose>1.5 0.0 0.20 0 0 0</pose>
      </include>
    </model>

    <model name="apple_bad">
      <include>
        <uri>model://AppleBad</uri>
        <static>true</static>
        <pose>1.5 0.0 0.25 0 0 0</pose>
      </include>
    </model>


    <!-- Row 1: banana_bad -->
    <model name="dish_banana_bad">
      <include>
        <uri>model://WhiteDish</uri>
        <static>true</static>
        <pose>0.0 -0.5 0.20 0 0 0</pose>
      </include>
    </model>

    <model name="banana_bad">
      <include>
        <uri>model://BananaBad</uri>
        <static>true</static>
        <pose>0.0 -0.5 0.25 0 0 0</pose>
      </include>
    </model>


    <!-- pizza_bad -->
    <model name="dish_pizza_bad">
      <include>
        <uri>model://WhiteDish</uri>
        <static>true</static>
        <pose>0.5 -0.5 0.20 0 0 0</pose>
      </include>
    </model>

    <model name="pizza_bad">
      <include>
        <uri>model://PizzaBad</uri>
        <static>true</static>
        <pose>0.5 -0.5 0.25 0 0 0</pose>
      </include>
    </model>

    <model name="toilet_1">
      <include>
        <uri>model://Toilet</uri>
        <static>true</static>
        <pose>1.0 -0.5 0.0 0 0 0</pose>
      </include>
    </model>

    <model name="nurse_1">
      <include>
        <uri>model://Scrubs</uri>
        <static>true</static>
        <pose>1.5 -0.5 0.0 0 0 0</pose>
      </include>
    </model>

    <!-- Row 2: red / blue / green cone / box -->
    <model name="cone_red_1">
      <include>
        <uri>model://red_cone</uri>
        <static>true</static>
        <pose>0.0 -1.0 0 0 0 0</pose>
      </include>
    </model>

    <model name="cone_blue_1">
      <include>
        <uri>model://blue_cone</uri>
        <static>true</static>
        <pose>0.5 -1.0 0 0 0 0</pose>
      </include>
    </model>

    <model name="cone_green_1">
      <include>
        <uri>model://green_cone</uri>
        <static>true</static>
        <pose>1.0 -1.0 0 0 0 0</pose>
      </include>
    </model>

    <model name="box_1">
      <include>
        <uri>model://box</uri>
        <static>false</static>
        <pose>1.5 -1.0 0.5 0 0 0</pose>
      </include>
    </model>

    <!-- Row 3: tile_red (goal_line_box) / stop_sign -->
    <!-- tile_red: 병원 맵의 goal_line_box를 원점 근처로 옮긴 버전 -->
    <model name="tile_red">
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>0.5 0.5 0.05</size>
            </box>
          </geometry>
          <material>
            <ambient>1 0 0 1</ambient>
            <diffuse>1 0 0 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
            <emissive>0 0 0 1</emissive>
          </material>
        </visual>
      </link>
      <!-- 바닥 바로 아래에 깔리는 타일 느낌으로 z를 약간 음수로 -->
      <pose>0.0 -1.5 -0.025 0 0 0</pose>
    </model>

    <!-- stop_sign: 병원 맵의 circle_sign -->
    <model name="stop_sign_1">
      <include>
        <uri>model://circle_sign</uri>
        <static>true</static>
        <pose>0.5 -1.5 0.0 0 0 0</pose>
      </include>
    </model>
   


    




  </world>
</sdf>
